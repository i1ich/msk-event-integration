# Copy to .env (never commit .env)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY=plaintext            # plaintext | iam
SCHEMA_REGISTRY_URL=http://localhost:8081
INGRESS_HMAC_SECRET=change-me-local-only
INGRESS_PORT=8080                 # port inside the container / local java -jar
INGRESS_HOST_PORT=8088            # docker compose host port for ingress
DOWNSTREAM_URL=http://localhost:8089/downstream
# AWS (M4 only; used by scripts/deploy.sh, teardown.sh, smoke-test.sh; no credentials here, use aws configure sso / env)
AWS_REGION=sa-east-1
ENV_NAME=dev
CLUSTER_TYPE=provisioned           # provisioned | serverless (serverless is not available in sa-east-1)
ALERT_EMAIL=                       # optional: email for observability alarms (AlarmEmail)
POSTGRES_HOST_PORT=5433
