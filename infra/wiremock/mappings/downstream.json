{
  "mappings": [
    {
      "name": "accounts: FAIL1 account fails once with 503, then recovers",
      "priority": 1,
      "scenarioName": "fail-once-accounts",
      "requiredScenarioState": "Started",
      "newScenarioState": "recovered",
      "request": {
        "method": "POST",
        "url": "/downstream/accounts",
        "bodyPatterns": [ { "matchesJsonPath": "$[?(@.accountId == '001xx000000FAIL1AAA')]" } ]
      },
      "response": { "status": 503, "headers": { "Content-Type": "application/json" }, "jsonBody": { "error": "temporarily unavailable" } }
    },
    {
