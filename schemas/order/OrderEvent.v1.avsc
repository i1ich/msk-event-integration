{
  "type": "record",
  "name": "OrderEvent",
  "namespace": "io.github.i1ich.mskei.schema",
  "doc": "Canonical order event (v1) built from Debezium CDC, produced to integration.order.v1.",
  "fields": [
    {"name": "eventId", "type": "string"},
    {"name": "orderId", "type": "long"},
    {"name": "op", "type": {"type": "enum", "name": "OrderOp", "symbols": ["CREATE", "UPDATE", "DELETE", "SNAPSHOT"]}},
    {"name": "accountId", "type": ["null", "string"], "default": null},
    {"name": "status", "type": ["null", "string"], "default": null},
    {"name": "amount", "type": ["null", "string"], "default": null, "doc": "Decimal as plain string to avoid bytes/decimal friction across serdes"},
    {"name": "currency", "type": ["null", "string"], "default": null},
    {"name": "updatedAt", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null},
    {"name": "sourceTsMs", "type": "long", "doc": "Debezium source.ts_ms"}
  ]
}
