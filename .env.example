# Copy to .env (never commit .env)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY=plaintext            # plaintext | iam
SCHEMA_REGISTRY_URL=http://localhost:8081
INGRESS_HMAC_SECRET=change-me-local-only
INGRESS_PORT=8080                 # port inside the container / local java -jar
INGRESS_HOST_PORT=8088            # docker compose host port for ingress
DOWNSTREAM_URL=http://localhost:8089/downstream
# AWS (M4 only)
AWS_REGION=eu-central-1
ENV_NAME=dev
POSTGRES_HOST_PORT=5433
